generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id        Int             @id @default(autoincrement())
  title     String
  amount    Int
  type      TransactionType
  category  String
  date      String
  note      String?
  createdAt DateTime        @default(now())
}